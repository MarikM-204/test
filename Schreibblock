</style>

<script>
(async function () {
  const liste = "Veteranenabzeichen-Anträge";
  const basis = window._spPageContextInfo.webAbsoluteUrl;
  const api = basis + "/_api/web/lists/getbytitle('" + liste + "')";
  const root = document.getElementById("veteranen-app");
  const form = document.getElementById("antrag-form");
  const speichern = document.getElementById("speichern");
  const statusMeldung = document.getElementById("app-status");
  const ausgabe = document.getElementById("antragsliste");
  const neuLaden = document.getElementById("neu-laden");
  const postBestaetigen = document.getElementById("post-bestaetigen");
  const statistikNeuLaden = document.getElementById("statistik-neu-laden");
  const statistikMeldung = document.getElementById("statistik-meldung");

  const feldAntragVom = "Antrag_x0020_vom";
  const statusPost = "Per Post an BAPersBw melden";
  const statusErledigt = "Postalisch erledigt";
  const statusAbgeschlossen = "Abgeschlossen";

  const statusWerte = [
    "Eingegangen", "In Bearbeitung", "Termin vereinbaren",
    "Termin vereinbart", "Rückfrage erwartet", statusPost,
    statusErledigt, statusAbgeschlossen
  ];

  let alleEintraege = [];
  let aktuelleSeite = "home";
  let aktuellerStatus = "";

  const editPanel = document.getElementById("va-edit-panel");
  const editForm = document.getElementById("va-edit-form");
  const editId = document.getElementById("va-edit-id");
  const editStatus = document.getElementById("va-edit-status");
  const editInfo = document.getElementById("va-edit-info");
  const editMessage = document.getElementById("va-edit-message");
  const editSave = document.getElementById("va-edit-save");

  function sicher(text) {
    return String(text == null ? "" : text).replace(/[&<>"']/g, function (c) {
      return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];
    });
  }

  function datumAnzeigen(wert) {
    if (!wert) return "";
    const d = new Date(wert);
    return isNaN(d.getTime()) ? "" : d.toLocaleDateString("de-DE");
  }

  function datumFeld(id) {
    const wert = document.getElementById(id).value;
    return wert ? new Date(wert + "T12:00:00").toISOString() : null;
  }

  function meldung(text, art) {
    statusMeldung.textContent = text;
    statusMeldung.className = "va-message va-visible " +
      (art === "error" ? "va-error" : "va-success");
  }

  function statistikHinweis(text, fehler) {
    statistikMeldung.textContent = text;
    statistikMeldung.className = "va-message va-visible " +
      (fehler ? "va-error" : "va-success");
  }

  function statistikAktualisieren() {
    const berlin = alleEintraege.filter(function (item) {
      return item.Status === statusAbgeschlossen;
    }).length;

    const postalisch = alleEintraege.filter(function (item) {
      return item.Status === statusErledigt;
    }).length;

    document.getElementById("stat-berlin").textContent = berlin;
    document.getElementById("stat-postalisch").textContent = postalisch;
    document.getElementById("stat-gesamt").textContent = alleEintraege.length;
  }

  function editMeldung(text, fehler) {
    editMessage.textContent = text;
    editMessage.className = "va-message va-visible " +
      (fehler ? "va-error" : "va-success");
  }

  function editSchliessen() {
    editPanel.hidden = true;
    editForm.reset();
    editMessage.className = "va-message";
  }

  function seiteAnzeigen(seite, statusFilter) {
    aktuelleSeite = seite;
    aktuellerStatus = statusFilter || "";

    root.querySelectorAll(".va-page").forEach(function (element) {
      element.hidden = true;
    });

    root.querySelectorAll(".va-nav").forEach(function (button) {
      button.classList.toggle("active", button.dataset.page === seite);
    });

    if (seite === "home") {
      document.getElementById("va-home").hidden = false;
    } else if (seite === "statistics") {
      document.getElementById("va-statistics-page").hidden = false;
      statistikAktualisieren();
      statistikMeldung.className = "va-message";
    } else if (seite === "form") {
      document.getElementById("va-form-page").hidden = false;
      statusMeldung.className = "va-message";
    } else {
      document.getElementById("va-list-page").hidden = false;

      const titel = document.getElementById("va-list-title");
      const beschreibung = document.getElementById("va-list-description");

      if (seite === "all") {
        titel.textContent = "Alle Anträge";
        beschreibung.textContent = "Alle geladenen Anträge aus SharePoint.";
      } else {
        titel.textContent = aktuellerStatus === statusPost
          ? "Post an BAPersBw"
          : aktuellerStatus === statusErledigt
            ? "Postalisch abgeschlossen"
            : aktuellerStatus;

        beschreibung.textContent =
          'Anträge mit dem Status "' + aktuellerStatus + '".';
      }

      postBestaetigen.hidden =
        !(seite === "status" && aktuellerStatus === statusPost);

      listeRendern();
    }

    if (seite !== "home") {
      root.scrollIntoView({behavior:"smooth", block:"start"});
    }
  }
  root.addEventListener("click", function (event) {
    const editButton = event.target.closest("button[data-edit-id]");

    if (editButton && root.contains(editButton)) {
      const id = Number(editButton.dataset.editId);
      const item = alleEintraege.find(function (eintrag) {
        return Number(eintrag.Id) === id;
      });

      if (!item) {
        alert("Der Antrag wurde nicht gefunden. Bitte aktualisiere die Liste.");
        return;
      }

      editId.value = item.Id;
      editStatus.value = statusWerte.includes(item.Status)
        ? item.Status : "Eingegangen";

      editInfo.textContent = "Antrag: " + (item.Title || "") + " " +
        (item.Nachname || "") +
        (item.Aktenzeichen ? " · Aktenzeichen: " + item.Aktenzeichen : "");

      editMessage.className = "va-message";
      editPanel.hidden = false;
      editPanel.scrollIntoView({behavior:"smooth", block:"center"});
      return;
    }

    const button = event.target.closest("button[data-page]");
    if (!button || !root.contains(button)) return;

    seiteAnzeigen(button.dataset.page, button.dataset.status || "");
  });

  function listeRendern() {
    let gefiltert = alleEintraege.slice();

    if (aktuelleSeite === "status") {
      gefiltert = gefiltert.filter(function (item) {
        return item.Status === aktuellerStatus;
      });
    }

    document.getElementById("va-result-count").textContent = gefiltert.length;

    if (!gefiltert.length) {
      ausgabe.innerHTML =
        '<div class="va-empty">Keine passenden Anträge gefunden.</div>';
      return;
    }

    let html = "<table><thead><tr>" +
      "<th>Vorname</th><th>Nachname</th>" +
      "<th>Aktenzeichen</th><th>Antrag vom</th><th>Eingangsdatum</th>" +
      "<th>Status</th><th>Termin</th><th>Wiedervorlage</th><th>Aktion</th>" +
      "</tr></thead><tbody>";

    gefiltert.forEach(function (item) {
      const s = String(item.Status || "");
      const statusKlasse =
        s === statusAbgeschlossen || s === statusErledigt ? "va-done" :
        s === "Rückfrage erwartet" || s === "Termin vereinbaren" ? "va-wait" : "";

      html += "<tr>" +
        "<td>" + sicher(item.Title) + "</td>" +
        "<td>" + sicher(item.Nachname) + "</td>" +
        "<td>" + sicher(item.Aktenzeichen) + "</td>" +
        "<td>" + sicher(datumAnzeigen(item[feldAntragVom])) + "</td>" +
        "<td>" + sicher(datumAnzeigen(item.Eingangsdatum)) + "</td>" +
        '<td><span class="va-status ' + statusKlasse + '">' +
        sicher(s || "Kein Status") + "</span></td>" +
        "<td>" + sicher(datumAnzeigen(item.Termin)) + "</td>" +
        "<td>" + sicher(datumAnzeigen(item.Wiedervorlage)) + "</td>" +
        '<td><button type="button" class="va-row-edit" data-edit-id="' +
        Number(item.Id) + '">Bearbeiten</button></td>' +
        "</tr>";
    });

    ausgabe.innerHTML = html + "</tbody></table>";
  }

  async function laden() {
    const url = api +
      "/items?$select=Id,Title,Nachname," + feldAntragVom +
      ",Aktenzeichen,Eingangsdatum,Status,Termin,Wiedervorlage,Bemerkung" +
      "&$top=100&$orderby=Id desc";

    const antwort = await fetch(url, {
      headers: {"Accept":"application/json;odata=nometadata"},
      credentials: "same-origin"
    });

    if (!antwort.ok) {
      const fehlerText = await antwort.text();
      throw new Error(
        "Antragsliste konnte nicht geladen werden (HTTP " +
        antwort.status + "). " + fehlerText.substring(0,250) +
        " Prüfe insbesondere den internen Spaltennamen von „Antrag vom“."
      );
    }

    const daten = await antwort.json();
    alleEintraege = daten.value || [];

    statistikAktualisieren();
    listeRendern();
  }

  async function sicherheitstokenHolen() {
    const antwort = await fetch(basis + "/_api/contextinfo", {
      method: "POST",
      headers: {"Accept":"application/json;odata=verbose"},
      credentials: "same-origin"
    });

    if (!antwort.ok) {
      throw new Error("Sicherheitstoken konnte nicht geladen werden (HTTP " +
        antwort.status + ").");
    }

    const daten = await antwort.json();
    return daten.d.GetContextWebInformation.FormDigestValue;
  }

  async function listenTypHolen() {
    const antwort = await fetch(api + "?$select=ListItemEntityTypeFullName", {
      headers: {"Accept":"application/json;odata=verbose"},
      credentials: "same-origin"
    });

    if (!antwort.ok) {
      throw new Error("SharePoint-Listeneinstellungen konnten nicht gelesen werden.");
    }

    const daten = await antwort.json();
    return daten.d.ListItemEntityTypeFullName;
  }

  async function statusSetzen(id, neuerStatus, digest, typ) {
    const antwort = await fetch(api + "/items(" + id + ")", {
      method: "POST",
      headers: {
        "Accept": "application/json;odata=verbose",
        "Content-Type": "application/json;odata=verbose",
        "X-RequestDigest": digest,
        "X-HTTP-Method": "MERGE",
        "IF-MATCH": "*"
      },
      credentials: "same-origin",
      body: JSON.stringify({
        "__metadata": {"type": typ},
        "Status": neuerStatus
      })
    });

    if (!antwort.ok) {
      const text = await antwort.text();
      throw new Error("HTTP " + antwort.status + ": " + text.substring(0,180));
    }
  }

  postBestaetigen.addEventListener("click", async function () {
    const zuBearbeiten = alleEintraege.filter(function (item) {
      return item.Status === statusPost;
    });

    if (!zuBearbeiten.length) {
      alert("Es gibt keine Anträge, die auf die E-Mail-Weiterleitung warten.");
      return;
    }

    const bestaetigt = window.confirm(
      "Bitte bestätige:\n\n" +
      "Hast du die Anträge tatsächlich per E-Mail an BAPersBw weitergeleitet?\n\n" +
      zuBearbeiten.length + " Antrag/Anträge werden auf „" +
      statusErledigt + "“ gesetzt.\n\n" +
      "Dieser Vorgang versendet keine E-Mail."
    );

    if (!bestaetigt) return;

    postBestaetigen.disabled = true;
    postBestaetigen.textContent = "Wird verarbeitet …";

    let erfolgreich = 0;
    const fehlerListe = [];

    try {
      const digest = await sicherheitstokenHolen();
      const typ = await listenTypHolen();

      for (const item of zuBearbeiten) {
        try {
          await statusSetzen(item.Id, statusErledigt, digest, typ);
          erfolgreich++;
        } catch (fehler) {
          fehlerListe.push(
            (item.Title || "") + " " + (item.Nachname || "") +
            " (ID " + item.Id + "): " + fehler.message
          );
        }
      }

      await laden();

      if (fehlerListe.length === 0) {
        alert(
          "Erfolgreich erledigt!\n\n" + erfolgreich +
          " Antrag/Anträge wurden auf „" + statusErledigt + "“ gesetzt."
        );
      } else {
        alert(
          "Die Verarbeitung ist teilweise abgeschlossen.\n\n" +
          "Erfolgreich geändert: " + erfolgreich +
          "\nFehlgeschlagen: " + fehlerListe.length +
          "\n\nFehlerdetails:\n" + fehlerListe.join("\n")
        );
      }

      seiteAnzeigen("status", statusPost);
    } catch (fehler) {
      alert(
        "Die Sammelverarbeitung konnte nicht vollständig gestartet werden:\n" +
        fehler.message
      );

      try { await laden(); } catch (_) {}
    } finally {
      postBestaetigen.disabled = false;
      postBestaetigen.textContent = "✓ Weiterleitung per E-Mail bestätigen";
    }
  });
  neuLaden.addEventListener("click", async function () {
    neuLaden.disabled = true;
    neuLaden.textContent = "Wird geladen …";

    try {
      await laden();
    } catch (fehler) {
      ausgabe.textContent = fehler.message;
    } finally {
      neuLaden.disabled = false;
      neuLaden.textContent = "↻ Aktualisieren";
    }
  });

  statistikNeuLaden.addEventListener("click", async function () {
    statistikNeuLaden.disabled = true;
    statistikNeuLaden.textContent = "Wird aktualisiert …";
    statistikMeldung.className = "va-message";

    try {
      await laden();
      statistikAktualisieren();
      statistikHinweis("Die Statistik wurde aktualisiert.", false);
    } catch (fehler) {
      statistikHinweis("Aktualisierung fehlgeschlagen: " + fehler.message, true);
    } finally {
      statistikNeuLaden.disabled = false;
      statistikNeuLaden.textContent = "↻ Statistik aktualisieren";
    }
  });

  form.addEventListener("submit", async function (event) {
    event.preventDefault();
    speichern.disabled = true;
    statusMeldung.className = "va-message";
    statusMeldung.textContent = "";

    try {
      const vorname = document.getElementById("vorname").value.trim();

      if (!vorname) throw new Error("Bitte gib einen Vornamen ein.");

      const digest = await sicherheitstokenHolen();
      const typ = await listenTypHolen();

      const eintrag = {
        "__metadata": {"type": typ},
        "Title": vorname,
        "Nachname": document.getElementById("nachname").value.trim(),
        [feldAntragVom]: datumFeld("antragVom"),
        "Aktenzeichen": document.getElementById("aktenzeichen").value.trim(),
        "Eingangsdatum": datumFeld("eingangsdatum"),
        "Status": document.getElementById("status").value,
        "Termin": datumFeld("termin"),
        "Wiedervorlage": datumFeld("wiedervorlage"),
        "Bemerkung": document.getElementById("bemerkung").value.trim()
      };

      const antwort = await fetch(api + "/items", {
        method: "POST",
        headers: {
          "Accept": "application/json;odata=verbose",
          "Content-Type": "application/json;odata=verbose",
          "X-RequestDigest": digest
        },
        credentials: "same-origin",
        body: JSON.stringify(eintrag)
      });

      if (!antwort.ok) {
        const text = await antwort.text();
        throw new Error("SharePoint hat nicht gespeichert (HTTP " +
          antwort.status + "). " + text.substring(0,350));
      }

      meldung("Der Antrag wurde erfolgreich in SharePoint gespeichert.", "success");
      form.reset();

      try {
        await laden();
        seiteAnzeigen("all");
      } catch (fehler) {
        meldung(
          "Der Antrag wurde gespeichert. Die Liste konnte nicht aktualisiert werden: " +
          fehler.message,
          "error"
        );
      }
    } catch (fehler) {
      meldung("Speichern fehlgeschlagen: " + fehler.message, "error");
    } finally {
      speichern.disabled = false;
    }
  });

  document.getElementById("va-edit-close").addEventListener("click", editSchliessen);
  document.getElementById("va-edit-cancel").addEventListener("click", editSchliessen);

  editForm.addEventListener("submit", async function (event) {
    event.preventDefault();
    editSave.disabled = true;
    editMessage.className = "va-message";

    try {
      const id = Number(editId.value);
      const neuerStatus = editStatus.value;

      if (!id || !statusWerte.includes(neuerStatus)) {
        throw new Error("Bitte wähle einen gültigen Status.");
      }

      const digest = await sicherheitstokenHolen();
      const typ = await listenTypHolen();

      await statusSetzen(id, neuerStatus, digest, typ);
      await laden();

      editPanel.hidden = false;
      editMeldung("Status wurde erfolgreich geändert.", false);
      listeRendern();
    } catch (fehler) {
      editMeldung("Fehler: " + fehler.message, true);
    } finally {
      editSave.disabled = false;
    }
  });

  try {
    await laden();
  } catch (fehler) {
    ausgabe.textContent = fehler.message;
    document.getElementById("stat-berlin").textContent = "!";
    document.getElementById("stat-postalisch").textContent = "!";
    document.getElementById("stat-gesamt").textContent = "!";
  }

  seiteAnzeigen("home");
})();
</script>